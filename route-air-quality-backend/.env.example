# ── Copy this file to .env and fill in real values ───────────────────────────
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres.dvwgipcrkzinlrmdomee
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=your-influxdb-admin-token
INFLUX_ORG=your-org
INFLUX_BUCKET=air_quality
INFLUX_ADMIN_PASSWORD=changeme   # only used by docker-compose init

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=300

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_ML=ml-artifacts

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CLERK_ENABLED=true
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_AUDIENCE=

# ── SMTP (email alerts & password reset) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_URL=http://localhost:3000

# ── External APIs ─────────────────────────────────────────────────────────────
OPENAQ_API_KEY=
WAQI_API_KEY=
OPENWEATHER_API_KEY=
CPCB_API_KEY=          # India CPCB — https://api.data.gov.in

# Routing provider — set one of the following:
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=http://router.project-osrm.org


# ── ML artifact paths (resolved inside the container) ────────────────────────
ML_MODEL_PATH=ml/lstm_air_quality_model.keras
ML_SCALER_PATH=ml/time_scaler.pkl

# ── Route scoring ─────────────────────────────────────────────────────────────
ROUTE_STATION_RADIUS_KM=2.0
ROUTE_MAX_ALTERNATIVES=3
LSTM_LOOKBACK_HOURS=24
